rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "canteenadmin1@gmail.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    match /login_lookup/{lookupId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && (
          // Owner syncing their own lookup docs
          request.resource.data.uid == request.auth.uid
          // Or admin managing any lookup doc
          || isAdmin()
        )
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.accountStatus is string
        && request.resource.data.accountStatus in ['pending', 'active', 'suspended'];

      allow delete: if isAdmin();
    }

    // ---------- USERS ----------
    // Reads are open so the login screen can look up an account by
    // email, username, or student ID before the user is authenticated.
    match /users/{userId} {
      allow read: if true;

      // ── Student self-update ──
      //  • cannot change role / accountStatus / studentId
      //  • CAN decrease credits (spending) but never increase
      //  • CAN decrease points (redeeming) but never increase
      allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.credits is number
          && request.resource.data.credits <= resource.data.credits
          && request.resource.data.credits >= 0
          && request.resource.data.points is int
          && request.resource.data.points <= resource.data.points
          && request.resource.data.points >= 0;

      // ── Admin full edit ──
      allow update: if isAdmin();

      // ── Account creation ──
      // Self-signup: a signed-in user can only create their own doc,
      // and only with safe defaults. Admin-created pending accounts go
      // through the same rule (admin isn't signed in on the secondary
      // app used by AdminAccountService — see the second allow below).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.points == 0
        && request.resource.data.credits == 0
        && (
          request.resource.data.accountStatus == 'active' ||
          request.resource.data.accountStatus == 'pending'
        );

      // Admin can also create any user doc (needed for pending accounts
      // created by the admin via the secondary Firebase app).
      allow create: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- CANTEEN ----------
    match /canteen/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- MENU ITEMS ----------
    match /menu_items/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Student: decrement stock only (made-to-order)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['stock', 'isAvailable'])
        && request.resource.data.stock is int
        && request.resource.data.stock < resource.data.stock
        && request.resource.data.stock >= 0
        && request.resource.data.isAvailable == (request.resource.data.stock > 0);

      // Student: decrement preparedPortions only (batch-cooked)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['preparedPortions', 'isAvailable'])
        && request.resource.data.preparedPortions is int
        && request.resource.data.preparedPortions < resource.data.preparedPortions
        && request.resource.data.preparedPortions >= 0
        && request.resource.data.isAvailable == (request.resource.data.preparedPortions > 0);
    }

    // ---------- INVENTORY ----------
    match /inventory/{itemId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.unit is string
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.minLevel is number
        && request.resource.data.minLevel >= 0;

      allow update: if isAdmin()
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0;

      allow delete: if isAdmin();
    }

    // ---------- ORDERS ----------
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.userId || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == resource.data.userId
            && resource.data.status == 'Pending'
            && request.resource.data.status == 'Cancelled');

      allow delete: if isAdmin();
    }

    // ---------- CREDIT TRANSACTIONS ----------
    match /credit_transactions/{txId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if isSignedIn()
        && (request.resource.data.uid == request.auth.uid || isAdmin());

      allow update, delete: if false;
    }

    // ---------- INVENTORY UNITS ----------
    match /inventory_units/{unitId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.nameLower is string;

      allow update, delete: if false;
    }

    // ---------- LOYALTY REWARDS ----------
    match /loyalty_rewards/{rewardId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.points is int
        && request.resource.data.points > 0
        && request.resource.data.points <= 100000
        && request.resource.data.isActive is bool;

      allow update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.points is int
        && request.resource.data.points > 0
        && request.resource.data.isActive is bool;

      allow delete: if isAdmin();
    }

    // ---------- POINTS TRANSACTIONS ----------
    match /points_transactions/{txId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'redeem'
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.balanceAfter is int
        && request.resource.data.balanceAfter >= 0
        && request.resource.data.rewardId is string
        && request.resource.data.rewardId.size() > 0
        && request.resource.data.redemptionId is string
        && request.resource.data.redemptionId.size() > 0;

      allow update, delete: if false;
    }

    // ---------- REDEMPTIONS ----------
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 6
        && request.resource.data.code.size() <= 16
        && request.resource.data.rewardId is string
        && request.resource.data.rewardName is string
        && request.resource.data.rewardName.size() > 0
        && request.resource.data.rewardName.size() <= 60
        && request.resource.data.pointsCost is int
        && request.resource.data.pointsCost > 0
        && request.resource.data.claimedAt == null
        && request.resource.data.claimedBy == null;

      // Admin flips pending → claimed. No `claimedAt is timestamp`
      // check because the value is a serverTimestamp sentinel.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid;

      allow delete: if false;
    }
  }
}