rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == "canteenadmin1@gmail.com";
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ═══════════════════════════════════════════════════════════════
    // USERS  (private — contains credits, points, studentId, etc.)
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // Owner can read their own doc; admin can read anyone's.
      allow read: if isSelf(userId) || isAdmin();

      // ── Student self-update ──
      //  • cannot change role / accountStatus / studentId
      //  • cannot change email / username (prevents account takeover)
      //  • CAN decrease credits (spending) but never increase
      //  • CAN decrease points (redeeming) but never increase
      allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountStatus == resource.data.accountStatus
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.email == resource.data.email
          && request.resource.data.username == resource.data.username
          && request.resource.data.credits is number
          && request.resource.data.credits <= resource.data.credits
          && request.resource.data.credits >= 0
          && request.resource.data.points is int
          && request.resource.data.points <= resource.data.points
          && request.resource.data.points >= 0;

      // ── Admin full edit ──
      allow update: if isAdmin();

      // ── Account creation (self-signup only) ──
      allow create: if isSelf(userId)
          && request.resource.data.role == 'user'
          && request.resource.data.points == 0
          && request.resource.data.credits == 0
          && request.resource.data.studentId == null
          && request.resource.data.tempPassword == null
          && (
            request.resource.data.accountStatus == 'active' ||
            request.resource.data.accountStatus == 'pending'
          );

      // Admin can create any user doc (pending accounts from admin panel).
      allow create: if isAdmin();

      allow delete: if isAdmin();
    }


    match /login_lookup/{identifier} {
      // Public read is required for unauthenticated login.
      allow read: if true;

      // Admin can create/update/delete any entry.
      allow create, update, delete: if isAdmin();
      allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == request.auth.token.email
          && (
            request.resource.data.accountStatus == 'active' ||
            request.resource.data.accountStatus == 'pending'
          );
    }

    // ═══════════════════════════════════════════════════════════════
    // CANTEEN (settings / metadata)
    // ═══════════════════════════════════════════════════════════════
    match /canteen/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // MENU ITEMS
    // ═══════════════════════════════════════════════════════════════
    match /menu_items/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Student: decrement stock only (made-to-order)
      allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stock', 'isAvailable'])
          && request.resource.data.stock is int
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.stock >= 0
          && request.resource.data.isAvailable == (request.resource.data.stock > 0);

      // Student: decrement preparedPortions only (batch-cooked)
      allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['preparedPortions', 'isAvailable'])
          && request.resource.data.preparedPortions is int
          && request.resource.data.preparedPortions < resource.data.preparedPortions
          && request.resource.data.preparedPortions >= 0
          && request.resource.data.isAvailable == (request.resource.data.preparedPortions > 0);
    }

    // ═══════════════════════════════════════════════════════════════
    // INVENTORY
    // ═══════════════════════════════════════════════════════════════
    match /inventory/{itemId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.unit is string
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.minLevel is number
          && request.resource.data.minLevel >= 0;

      allow update: if isAdmin()
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // ORDERS
    // ═══════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
          (isSelf(resource.data.userId) || isAdmin());

      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
          || (isSignedIn()
              && isSelf(resource.data.userId)
              && resource.data.status == 'Pending'
              && request.resource.data.status == 'Cancelled');

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // CREDIT TRANSACTIONS
    // ═══════════════════════════════════════════════════════════════
    match /credit_transactions/{txId} {
      allow read: if isSignedIn() &&
          (isSelf(resource.data.uid) || isAdmin());

      // Only the owner can create a *debit* (spending) tx.
      allow create: if isSignedIn()
          && isSelf(request.resource.data.uid)
          && request.resource.data.type == 'debit'
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;

      allow create: if isAdmin();

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // INVENTORY UNITS
    // ═══════════════════════════════════════════════════════════════
    match /inventory_units/{unitId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.nameLower is string;

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // LOYALTY REWARDS
    // ═══════════════════════════════════════════════════════════════
    match /loyalty_rewards/{rewardId} {
      allow read: if isSignedIn();

      allow create: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.points is int
          && request.resource.data.points > 0
          && request.resource.data.points <= 100000
          && request.resource.data.isActive is bool;

      allow update: if isAdmin()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.points is int
          && request.resource.data.points > 0
          && request.resource.data.isActive is bool;

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // POINTS TRANSACTIONS
    // ═══════════════════════════════════════════════════════════════
    match /points_transactions/{txId} {
      allow read: if isSignedIn() &&
          (isSelf(resource.data.uid) || isAdmin());

      allow create: if isAdmin();

      allow create: if isSignedIn()
          && isSelf(request.resource.data.uid)
          && request.resource.data.type == 'redeem'
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.rewardId is string
          && request.resource.data.rewardId.size() > 0
          && request.resource.data.redemptionId is string
          && request.resource.data.redemptionId.size() > 0;

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // REDEMPTIONS
    // ═══════════════════════════════════════════════════════════════
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn()
          && (isSelf(resource.data.userId) || isAdmin());

      allow create: if isSignedIn()
          && isSelf(request.resource.data.userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 6
          && request.resource.data.code.size() <= 16
          && request.resource.data.rewardId is string
          && request.resource.data.rewardName is string
          && request.resource.data.rewardName.size() > 0
          && request.resource.data.rewardName.size() <= 60
          && request.resource.data.pointsCost is int
          && request.resource.data.pointsCost > 0
          && request.resource.data.claimedAt == null
          && request.resource.data.claimedBy == null;

      allow update: if isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'claimed'
          && request.resource.data.claimedBy == request.auth.uid;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}